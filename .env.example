# Salin file ini menjadi .env lalu isi dengan nilai dari
# dashboard Supabase kamu: Project Settings → API.
#
#   VITE_SUPABASE_URL              → "Project URL"
#   VITE_SUPABASE_ANON_KEY         → "anon public" key / "publishable" key
#   (Bisa juga pakai VITE_SUPABASE_PUBLISHABLE_KEY)
#
# Jangan pernah commit .env (sudah masuk .gitignore).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Atau:
# VITE_SUPABASE_PUBLISHABLE_KEY=
